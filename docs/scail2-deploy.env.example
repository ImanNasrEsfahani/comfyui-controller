# Add to private ROOT .env on backend (NEVER COMMIT)
CHARACTER_REPLACE_ENABLED=false
CHARACTER_REPLACE_WORKER_TOKEN=<generate-a-new-64-plus-character-secret>
# Configure SALAD as a SEPARATE container group:
# IMAGE: ghcr.io/imannasresfahani/comfyui-controller-scail2-worker:thin
# GPU: RTX 5090 (32GB VRAM); host memory recommended >=64GB; disk >=100GB
# Desired replicas: 1 for first end-to-end validation; then design a separate autoscaler.
# Env on Salad worker (same private token):
CHARACTER_REPLACE_BACKEND=https://comfy.imannasr.com
CHARACTER_REPLACE_WORKER_TOKEN=<same-private-secret>
SCAIL2_BAKE_MODE=thin
PORT=3000
