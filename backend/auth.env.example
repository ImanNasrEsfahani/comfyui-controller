# Phase02 Auth. Add to your PRIVATE server .env only after migration + security review.
# Default disabled: keeps existing single-operator frontend/backend behavior unchanged.
AUTH_ENABLED=false
AUTH_REGISTRATION_MODE=invite
AUTH_PUBLIC_ORIGIN=https://comfy.example.com
# Generate an independent >=32 char random secret locally, never commit it:
# python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
AUTH_CSRF_SECRET=
AUTH_IDLE_SECONDS=3600
AUTH_SESSION_SECONDS=86400
AUTH_REMEMBER_SECONDS=2592000
# Verified TLS SMTP required to enable real registration/password recovery.
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_FROM=
AUTH_SMTP_USER=
AUTH_SMTP_PASSWORD=
# MFA remains disabled in Phase02; not a claim of MFA protection.
AUTH_MFA_ENABLED=false
