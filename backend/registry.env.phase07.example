# Phase07 registry remains disabled by default.
MODEL_REGISTRY_ENABLED=false
# NOTE: VITE_AUTH_UI_ENABLED is a build-time FRONTEND flag, not a server auth control.
# No trusted GPU approval/activation exists in this phase. NEVER auto-switch legacy Salad.
# Exact allowed GHCR repositories, comma-separated. Default empty = deny imports.
MODEL_REGISTRY_TRUSTED_REPOS=
