# Phase12 preview, disabled by default. Never starts/stops real Salad GPU.
SCHEDULER_V12_UI_ENABLED=false
# Dedicated Sessions, Worker Claim, and production Provider reconciler are NOT implemented.
SCHEDULER_V12_DISPATCH_ENABLED=false
SCHEDULER_V12_PROVIDER_CONTROL_ENABLED=false
SCHEDULER_V12_DEDICATED_ENABLED=false
# Keep the old controller's auto-scaling OFF when evaluating a new allocator.
DIRECT_GPU_AUTO_CONTROL=false
