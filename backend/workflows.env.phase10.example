# Stage10 is OFF by default, requires Phase09 opt-in + migrations.
# Configure only in a disposable staging environment after security review.
WORKFLOW_COMPILER_ENABLED=false
WORKFLOW_STUDIO_ENABLED=false
WORKFLOW_STUDIO_POWER_USERS_ENABLED=false
WORKFLOW_PUBLISH_METADATA_ENABLED=false
WORKFLOW_UNPUBLISH_ENABLED=false
# Frontend build-time flag (separate from backend .env)
VITE_WORKFLOW_STUDIO_ENABLED=false
