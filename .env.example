APP_NAME=qwen-comfyui-controller
DB_PATH=/app/data/controller.db
MAX_UPLOAD_MB=100

SALAD_API_KEY=
SALAD_ORG=
SALAD_PROJECT=
SALAD_QUEUE=qwen-comfyui

R2_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=qwen-comfyui
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_PRESIGN_TTL_SECONDS=21600

# Optional. If set, frontend/backend can use this only behind your own auth-aware proxy.
# Prefer Cloudflare Access for browser authentication.
APP_INTERNAL_TOKEN=
