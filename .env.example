APP_NAME=qwen-comfyui-controller
DB_PATH=/app/data/controller.db
MAX_UPLOAD_MB=100

# SaladCloud: one Medium Queue + one Medium Container Group.
SALAD_API_KEY=
SALAD_ORG=imanprojects
SALAD_PROJECT=comfy
SALAD_QUEUE_PREFIX=qwen-comfyui
SALAD_CONTAINER_GROUP_PREFIX=qwen-comfyui-fp8
SALAD_DEFAULT_PRIORITY=medium
# This is the CURRENT baked Worker image, not the manually tested PyTorch image.
SALAD_IMAGE=ghcr.io/imannasresfahani/comfyui-controller-salad-worker:fp8-baked
# Fixed by deploy_salad.py: RTX 5090 (32 GB VRAM); 4 CPU; 30 GB RAM; 2 GB SHM; 100 GB disk.
SALAD_GPU_NAMES="RTX 5090 (32 GB)"
SALAD_INITIAL_REPLICAS=0
SALAD_MIN_REPLICAS=0
SALAD_MAX_REPLICAS=1
SALAD_DESIRED_QUEUE_LENGTH=1
SALAD_POLLING_PERIOD=30
SALAD_CONFIG_SETTLE_TIMEOUT=600
SALAD_CONFIG_SETTLE_POLL_SECONDS=5

# Retain for reading historic jobs; do not route NEW jobs here.
SALAD_LEGACY_QUEUE=qwen-comfyui

# Cloudflare R2
R2_ENDPOINT_URL=https://4ec2a271e2c8320bc046ad41a67d36f2.r2.cloudflarestorage.com
R2_BUCKET=comfy
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_PRESIGN_TTL_SECONDS=21600

HF_TOKEN=
APP_INTERNAL_TOKEN=
