# Copy to private .env on the server. Never commit .env or real credentials.
# This example matches the current comfyui-controller backend + Salad deployer.

# Application / UI
APP_NAME=qwen-comfyui-controller
DB_PATH=/app/data/controller.db
MAX_UPLOAD_MB=100
# Required for private Job, prompt, upload, output, Workflow, and infrastructure
# APIs, as well as administrative actions. Use a long random value.
APP_INTERNAL_TOKEN=
# A long-running job is shown as STALLED, not confirmed FAILED.
JOB_STALE_MINUTES=180

# The three mutable settings (image, group name, display name) live in SQLite.
# On FIRST upgrade, start backend ONCE with the existing private .env intact
# to migrate them; only then remove those three lines from private .env.
# Salad organization and exactly one active Queue + Container Group.
SALAD_API_KEY=
SALAD_API_BASE_URL=https://api.salad.com/api/public
SALAD_USER_AGENT=comfyui-controller/env-only-1.0
SALAD_HTTP_TIMEOUT_SECONDS=30
SALAD_ORG=imanprojects
SALAD_PROJECT=comfy
SALAD_QUEUE_NAME=qwen-comfyui-medium
SALAD_QUEUE_DISPLAY_NAME="Qwen ComfyUI Medium Jobs"
SALAD_PRIORITY=medium
SALAD_GPU_NAME="RTX 5090 (32 GB)"
# Optional operator estimate. This is not fetched from Salad and does not
# replace an invoice or billing statement. Leave blank to show cost as unknown.
SALAD_GPU_HOURLY_RATE=
SALAD_GPU_RATE_CURRENCY=USD

# GPU hardware (CPU count; RAM and shared memory in MB; disk in GB).
SALAD_CPU=4
SALAD_MEMORY_MB=30720
SALAD_SHM_MB=2048
SALAD_STORAGE_GB=100

# Scale-to-zero; use --apply --bootstrap explicitly to request a paid replica.
SALAD_INITIAL_REPLICAS=0
SALAD_BOOTSTRAP_REPLICAS=1
SALAD_MIN_REPLICAS=0
SALAD_MAX_REPLICAS=1
SALAD_RESTART_POLICY=always
SALAD_AUTOSTART_POLICY=true

# Salad Queue connection and Autoscaler.
SALAD_QUEUE_CONNECTION_PATH=/prompt
SALAD_WORKER_PORT=3000
SALAD_WORKER_SCHEME=http
SALAD_DESIRED_QUEUE_LENGTH=1
SALAD_POLLING_PERIOD=30
SALAD_MAX_UPSCALE_PER_MINUTE=1
SALAD_MAX_DOWNSCALE_PER_MINUTE=1

# Environment passed to the Salad Worker.
SALAD_MANIFEST_PATH=/opt/qvr-salad/manifest.yaml
SALAD_LRU_CACHE_SIZE_GB=40
SALAD_LOG_LEVEL=info
SALAD_READY_TIMEOUT_SECONDS=1800
SALAD_STARTUP_CHECK_MAX_TRIES=360
SALAD_STARTUP_CHECK_INTERVAL_S=5

# Readiness probe.
SALAD_READINESS_PATH=/ready
SALAD_READINESS_INITIAL_DELAY_SECONDS=30
SALAD_READINESS_PERIOD_SECONDS=30
SALAD_READINESS_TIMEOUT_SECONDS=5
SALAD_READINESS_SUCCESS_THRESHOLD=1
SALAD_READINESS_FAILURE_THRESHOLD=20

# Startup probe.
SALAD_STARTUP_PATH=/health
SALAD_STARTUP_INITIAL_DELAY_SECONDS=120
SALAD_STARTUP_PERIOD_SECONDS=90
SALAD_STARTUP_TIMEOUT_SECONDS=5
SALAD_STARTUP_SUCCESS_THRESHOLD=1
SALAD_STARTUP_FAILURE_THRESHOLD=20

# Control-plane configuration updates.
SALAD_CONFIG_SETTLE_TIMEOUT=600
SALAD_CONFIG_SETTLE_POLL_SECONDS=5

# Historic Salad Queue jobs remain readable; new jobs use the local SQLite queue
# only after DIRECT_QUEUE_ENABLED=true. Keep the legacy queue names unchanged.
SALAD_LEGACY_QUEUE=qwen-comfyui

# DIRECT MIGRATION (opt-in; leave false until the new image and group are ready)
DIRECT_QUEUE_ENABLED=false
# Generate locally: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# Place THE SAME secret here and in the new Salad group's environment (the
# Backend deployer injects it automatically from this private .env).
DIRECT_WORKER_TOKEN=
DIRECT_BACKEND_URL=https://comfy.imannasr.com
DIRECT_MAX_ATTEMPTS=3
DIRECT_LEASE_SECONDS=120
DIRECT_WORKER_JOB_TIMEOUT_SECONDS=3600
DIRECT_STARTUP_TIMEOUT_SECONDS=1800
DIRECT_IDLE_SECONDS=900
DIRECT_POLL_SECONDS=20
# Billing safety: no automatic GPU allocation until explicitly enabled.
DIRECT_GPU_AUTO_CONTROL=false
# Fresh authenticated Worker status threshold used by Infrastructure readiness.
DIRECT_WORKER_STATUS_STALE_SECONDS=90
# Keep SALAD_RESTART_POLICY=always only for old groups. New direct groups
# are created automatically with restart_policy=never.


# Cloudflare R2: private credentials belong only in server .env.
R2_ENDPOINT_URL=
R2_BUCKET=comfy
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_PRESIGN_TTL_SECONDS=21600

# Optional Hugging Face token; leave blank unless required.
HF_TOKEN=
